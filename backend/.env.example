# RoadGuard AI — Backend Environment Configuration Template

PORT=8000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/roadguard

# JWT Secret & Expiration
JWT_SECRET=supersecret_roadguard_key
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
FRONTEND_URL=*

# Python AI Microservice URL
AI_SERVICE_URL=http://localhost:5000
